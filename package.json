{
  "name": "figma-guitar-tab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.plugin.json && tsc -p tsconfig.ui.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.140.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.86.0",
    "oxfmt": "0.71.0",
    "oxlint-tsgolint": "^7.0.2003",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
