root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,mjs,json,css,html}]
indent_size = 2

[*.md]
# Prose uses semantic line breaks, so lines are as long as a sentence needs.
# Don't let an editor reflow them to a column.
max_line_length = off
